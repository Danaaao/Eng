# Copy this file to .env and fill in your own values.
# cp .env.example .env

# --- LLM generation (OpenRouter, OpenAI-compatible) ---------------------------
# Without a key the platform still runs end to end: it falls back to a
# deterministic extractive answerer that quotes the retrieved evidence verbatim.
OPENROUTER_API_KEY=your_api_key_here
OPENROUTER_MODEL=qwen/qwen3-coder:free

# --- Model layer --------------------------------------------------------------
EMBED_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
RERANK_MODEL_NAME=cross-encoder/ms-marco-MiniLM-L-6-v2

# --- Source system: ClinicalTrials.gov ----------------------------------------
CTGOV_CONDITION=type 2 diabetes
CTGOV_TARGET_RECORDS=60

# --- Storage ------------------------------------------------------------------
CHROMA_DB_DIR=data/chroma_db
