# Secrets
.env

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/

# Platform runtime output — regenerated by `--stage pipeline`
data/*
pipeline_execution.log

# ...except the raw ClinicalTrials.gov response. That file IS the dataset: it is
# the untouched registry payload the pipeline downloaded, kept under version
# control so anyone can replay the whole pipeline offline on the exact same data
# (`--stage pipeline --offline`). This is the ELT principle in practice — raw
# data is preserved forever, transformations are re-run against it.
!data/landing_zone/
data/landing_zone/*
!data/landing_zone/ctgov_raw.json

# OS
.DS_Store
